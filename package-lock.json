{
  "name": "pixel-studio-repo",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "pixel-studio-repo",
      "workspaces": [
        "packages/runtime",
        "packages/pixel-studio"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/@pixel-studio/core": {
      "resolved": "packages/pixel-studio",
      "link": true
    },
    "node_modules/@pixel-studio/runtime": {
      "resolved": "packages/runtime",
      "link": true
    },
    "packages/pixel-studio": {
      "name": "@pixel-studio/core",
      "version": "0.2.0-alpha.3",
      "license": "MIT",
      "dependencies": {
        "@pixel-studio/runtime": "0.2.0-alpha.3"
      },
      "bin": {
        "pixel": "bin/pixel.mjs"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/runtime": {
      "name": "@pixel-studio/runtime",
      "version": "0.2.0-alpha.3",
      "license": "MIT"
    }
  }
}
