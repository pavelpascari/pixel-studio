# Response headers for Cloudflare Workers static assets (copied to dist/_headers; not served itself).
# Syntax: a URL pattern line, then indented `Name: value` lines. All matching rules apply, so set each header
# in one rule only (a header set by two rules gets both values joined with a comma).
# Docs: https://github.com/pavelpascari/astro-project-site (Deploy).

/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # Only this site may frame its pages (live examples and embedded tools iframe same-origin pages).
  Content-Security-Policy: frame-ancestors 'self'
  # A stricter policy, to adopt once you know what your examples need. It still allows the inline module
  # scripts and same-origin iframes the template uses; 'unsafe-eval' is not included, add it if a live
  # example evaluates code. Replace the line above with it (one Content-Security-Policy header only):
  # Content-Security-Policy: default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; worker-src 'self' blob:; frame-src 'self'; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'

# Astro's bundled assets have content hashes in their names: cache them forever.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Everything else (HTML, mirrored apps, search index, images in public/) keeps the platform default,
# `public, max-age=0, must-revalidate` with an ETag: browsers revalidate on every load, so a deploy is
# visible at once and unchanged files cost a 304.
