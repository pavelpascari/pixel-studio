---
// The landing page: Pixel Studio's own page at /, replacing the one astro-project-site injects. Every character on
// it is a live <pixel-sprite> or <pixel-actor> playing a bundle from demo/assets/ (served from the /apps/ mirror),
// with the runtime from packages/runtime/src/: the page is its own demo.
import { BaseLayout, CallToAction, GalleryStrip, InstallCommand, Section, Steps } from 'astro-project-site/components';
import '../styles/landing.css';

const assets = '/apps/demo/assets';

// The hero line-up: hover and click animations are each bundle's own (see `npx pixel preview`).
const lineup = [
  { src: 'goose-root', alt: 'root, a hacker goose in a hoodie', hover: 'waddle', click: 'hack' },
  { src: 'fox', alt: 'Ember the fox', hover: 'trot', click: 'leap' },
  { src: 'pip', alt: 'Pip the adventurer', hover: 'walk', click: 'wave' },
  { src: 'robot', alt: 'Bolt the robot', hover: 'walk', click: 'wave' },
  { src: 'slime', alt: 'Gloop the slime', hover: 'hop', click: 'hop' },
  { src: 'moss', alt: 'Moss', hover: 'think', click: 'wave' },
  { src: 'goose-sudo', alt: 'sudo, a loud canada goose', hover: 'waddle', click: 'headbang' },
];

const steps = [
  {
    title: 'Install',
    body: 'The engine and the pixel command. A site that only plays sprites needs just @pixel-studio/runtime.',
    code: 'npm i @pixel-studio/core',
    lang: 'sh',
  },
  {
    title: 'Describe a character',
    body: 'Start from an example and change what differs; every motion of its figure comes with it.',
    code: `{ "extends": "./node_modules/@pixel-studio/core/examples/goose-base.json",
  "name": "Marigold",
  "materials": { "feather": { "color": "#e8b04a" }, "beak": { "color": "#d94b32" } } }`,
    lang: 'json',
  },
  {
    title: 'Check it, look at it, bundle it',
    body: 'Errors carry a JSON path and a did-you-mean; the preview shows every animation at 16, 32 and 64 px.',
    code: `npx pixel validate my-goose.json
npx pixel preview  my-goose.json --out my-goose.png
npx pixel bundle   my-goose.json --out my-goose.bundle.json`,
    lang: 'sh',
  },
  {
    title: 'Put it on a page',
    body: 'One module, one tag.',
    code: `<script type="module" src="pixel-sprite.js"></script>
<pixel-sprite src="my-goose.bundle.json" anim="idle" size="128"
              hover-anim="waddle" click-anim="honk" alt="Marigold"></pixel-sprite>`,
    lang: 'html',
  },
];
---

<BaseLayout>
  <section class="ps-hero" aria-labelledby="ps-hero-title">
    <div class="ps-hero-text">
      <p class="ps-eyebrow">Pixel-art characters for the web</p>
      <h1 id="ps-hero-title">Characters that live on your page.</h1>
      <p class="ps-lead">
        Describe a character in JSON, or ask Claude to. Pixel Studio draws it as crisp pixel art at every size, with
        motion that keeps its feet on the ground, and one tag plays it on any website.
      </p>
      <div class="ps-actions">
        <a class="site-btn site-btn--primary" href="/docs/reference/getting-started/">Get started</a>
        <a class="site-btn" href="/apps/studio/">Open the studio</a>
      </div>
      <InstallCommand command="npm i @pixel-studio/core" />
    </div>
    <div class="ps-lineup" role="group" aria-label="Characters made with Pixel Studio: hover or tap them">
      {lineup.map((c) => (
        <pixel-sprite
          src={`${assets}/${c.src}.bundle.json`}
          anim="idle"
          size="96"
          hover-anim={c.hover}
          click-anim={c.click}
          alt={c.alt}
        />
      ))}
      <p class="ps-hint" aria-hidden="true">Hover them. Click them.</p>
    </div>
  </section>

  <Section id="packages" title="Two packages, one version" intro="Make characters with one; play them anywhere with the other. They are always released together.">
    <div class="ps-packages">
      <article class="ps-package">
        <p class="ps-tag">@pixel-studio/runtime</p>
        <h3>Play them</h3>
        <p>
          <code>&lt;pixel-sprite&gt;</code> plays a character on any page; <code>&lt;pixel-stage&gt;</code> lets characters
          walk, climb and hide on your page's own elements. One ES module each, no dependencies, no build step.
        </p>
        <InstallCommand command="npm i @pixel-studio/runtime" />
        <a href="/docs/reference/runtime/">The runtime <span aria-hidden="true">→</span></a>
      </article>
      <article class="ps-package">
        <p class="ps-tag">@pixel-studio/core</p>
        <h3>Make them</h3>
        <p>
          The engine, the <code>pixel</code> command, a library of figures with realistic motion, and example
          characters. The studio puts it in a browser, with Claude as your co-author.
        </p>
        <InstallCommand command="npm i @pixel-studio/core" />
        <a href="/docs/reference/spec/">The spec format <span aria-hidden="true">→</span></a>
      </article>
    </div>
  </Section>

  <Section id="runtime" tone="surface" title="One tag. Sharp on every screen." intro="A bundle is one JSON file with the character's sprite sheets at 16, 32 and 64 px. The runtime picks the sharpest sheet for the size and the screen, and scales it in whole device pixels: no blur, at any size.">
    <div class="ps-split">
      <div class="ps-sizes" role="group" aria-label="The same bundle at four sizes">
        {[32, 64, 128, 192].map((size) => (
          <figure>
            <pixel-sprite src={`${assets}/fox.bundle.json`} anim="idle" size={size} hover-anim="trot" alt={`Ember the fox at ${size} px`} />
            <figcaption>{size} px</figcaption>
          </figure>
        ))}
      </div>
      <ul class="ps-points">
        <li><strong>Interactive.</strong> <code>hover-anim</code> and <code>click-anim</code>, events for footsteps and landings, attachment points (where its mouth is), state machines and skins.</li>
        <li><strong>Moves at the right speed.</strong> Each walk knows its pixels per second, so a sprite moved across the page keeps its feet planted.</li>
        <li><strong>Polite.</strong> Pauses off-screen, respects reduced motion, and reads its <code>alt</code> to screen readers.</li>
        <li><strong>Small.</strong> One file with no imports. Need a game engine instead? <code>pixel export</code> writes sheets Phaser and PixiJS load.</li>
      </ul>
    </div>
  </Section>

  <Section id="stage" title="Let them loose on your layout" intro="<pixel-stage> turns ordinary elements into ground: mark a card as a surface, and characters walk along it, jump to the next, climb its side, sit on its edge and hide behind things. They never block a click.">
    <div class="ps-playground">
      <div class="ps-cards">
        <article class="ps-card" data-pixel-surface data-pixel-climbable>
          <h3>Surfaces</h3>
          <p><code>data-pixel-surface</code>: the element's top edge is a platform.</p>
        </article>
        <article class="ps-card ps-card--high" data-pixel-surface data-pixel-climbable>
          <h3>Walls</h3>
          <p><code>data-pixel-climbable</code>: its sides can be climbed.</p>
        </article>
        <article class="ps-card" data-pixel-surface data-pixel-climbable>
          <h3>Hiding spots</h3>
          <p><code>data-pixel-hide</code>: duck behind it and peek out.</p>
          <div class="ps-crate" data-pixel-hide aria-hidden="true"></div>
        </article>
      </div>
      <div class="ps-ground" data-pixel-surface aria-hidden="true"></div>
      <p class="ps-caption">These cards are plain HTML. Tap a character to shoo it.</p>
    </div>
    <pixel-stage label="characters" controls="none">
      <pixel-actor src={`${assets}/goose-root.bundle.json`} size="56" alt="root, a hacker goose" start=".ps-card--high"></pixel-actor>
      <pixel-actor src={`${assets}/fox.bundle.json`} size="56" alt="Ember the fox" start=".ps-ground"></pixel-actor>
      <pixel-actor src={`${assets}/pip.bundle.json`} size="56" alt="Pip the adventurer" start=".ps-card"></pixel-actor>
    </pixel-stage>
    <p class="ps-more"><a href="/apps/demo/stage.html">The full stage demo <span aria-hidden="true">→</span></a> · <a href="/docs/reference/stage/">How it works <span aria-hidden="true">→</span></a></p>
  </Section>

  <Section id="studio" tone="surface" title="The studio: describe it, and Claude draws it" intro="Write what you want in a sentence. Claude writes the spec, the engine renders it at every size, and the render goes back to Claude to look at and refine, until it is right. Or edit the JSON yourself, with the preview beside it.">
    <div class="ps-split ps-split--studio">
      <ol class="ps-loop">
        <li><span>1</span><div><strong>Describe</strong> “a small grey robot with an antenna that waves hello”.</div></li>
        <li><span>2</span><div><strong>Claude writes the spec</strong>, from the same brief the CLI prints with <code>pixel brief</code>; validation errors go straight back to it.</div></li>
        <li><span>3</span><div><strong>The engine renders</strong> a contact sheet: every animation at 16, 32 and 64 px.</div></li>
        <li><span>4</span><div><strong>Claude looks at the render</strong> and revises. Then export a bundle for the web.</div></li>
      </ol>
      <figure class="ps-shot">
        <img src="/landing/studio.webp" width="1280" height="800" alt="The studio: the JSON spec on the left; the goose large in the middle, its animations above and the same goose at 16 to 64 px below; rendering settings on the right" loading="lazy" decoding="async" />
      </figure>
    </div>
    <p class="ps-note">Bring your own Anthropic API key: it stays in your browser, and requests go straight to the API. Without one, the studio is a spec editor with a live preview.</p>
    <div class="ps-actions">
      <a class="site-btn site-btn--primary" href="/apps/studio/">Open the studio</a>
      <a class="site-btn" href="/apps/studio/play.html">Try the playground</a>
    </div>
  </Section>

  <Section id="motion" title="Motion that looks measured, because it is" intro="A character stands on a figure: a skeleton with motion models for walking, running, jumping, climbing and more. Feet stay planted, heads stay steady, tails follow through. The fox's gallop is measured from Muybridge's photographs of running hounds: all motion data comes from public-domain and openly licensed sources.">
    <div class="ps-gaits">
      <figure><pixel-sprite src={`${assets}/fox.bundle.json`} anim="gallop" size="128" alt="the fox galloping" /><figcaption><code>dog</code> figure · gallop</figcaption></figure>
      <figure><pixel-sprite src={`${assets}/goose-kiddie.bundle.json`} anim="waddle" size="128" alt="a gosling waddling" /><figcaption><code>goose</code> figure · waddle</figcaption></figure>
      <figure><pixel-sprite src={`${assets}/pip.bundle.json`} anim="run" size="128" alt="Pip running" /><figcaption><code>human</code> figure · run</figcaption></figure>
      <figure><pixel-sprite src={`${assets}/moss.bundle.json`} anim="climb" size="128" alt="Moss climbing" /><figcaption>climb</figcaption></figure>
    </div>
    <p class="ps-more"><a href="/apps/studio/figures.html">Explore the figures <span aria-hidden="true">→</span></a> · <a href="/docs/reference/figures/">Figures and motion models <span aria-hidden="true">→</span></a></p>
  </Section>

  <Section id="start" tone="surface" title="Five minutes to a goose on your page">
    <Steps items={steps} />
  </Section>

  <GalleryStrip title="See it running" intro="Demo sites, a game and the studio's tools, all built with the two packages." limit={3} />

  <CallToAction
    title="Give your project a character"
    body="Free and open source under the MIT licence. Every example on this site is live."
    primary={{ label: 'Get started', href: '/docs/reference/getting-started/' }}
    secondary={{ label: 'Read the guide', href: '/docs/guide/' }}
  />

  <button type="button" class="ps-pause" aria-pressed="false">Pause characters</button>

  <script is:inline type="module" src="/apps/packages/runtime/src/pixel-stage.js"></script>
  <script>
    // One control for every character on the page (WCAG 2.2.2: moving content needs a way to pause it): the
    // sprites, and the stage, whose own button is turned off (controls="none"). The stage remembers its state.
    const button = document.querySelector<HTMLButtonElement>('.ps-pause')!;
    const set = (paused: boolean) => {
      button.setAttribute('aria-pressed', String(paused));
      button.textContent = paused ? 'Play characters' : 'Pause characters';
      for (const sprite of document.querySelectorAll('pixel-sprite')) sprite.toggleAttribute('paused', paused);
      const stage = document.querySelector('pixel-stage') as (HTMLElement & { pause(): void; resume(): void }) | null;
      if (stage?.pause) (paused ? stage.pause() : stage.resume());
    };
    button.addEventListener('click', () => set(button.getAttribute('aria-pressed') !== 'true'));
    customElements.whenDefined('pixel-stage').then(() => {
      const stage = document.querySelector('pixel-stage') as (HTMLElement & { paused?: boolean }) | null;
      if (stage?.paused) set(true);
    });
  </script>
</BaseLayout>
