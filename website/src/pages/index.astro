---
// The landing page: Pixel Studio's own page at /, replacing the one astro-project-site injects. Every character on
// it is a live <pixel-sprite> or <pixel-actor> playing a bundle from demo/assets/ (served from the /apps/ mirror),
// with the runtime from packages/runtime/src/: the page is its own demo.
//
// The order follows a visitor's questions: what is it (a character to direct on a small page), could it be mine (the
// same goose in other looks), how much work is it (the embed), what can it do there (it reacts to the reader and the
// page), how do I make my own (the studio), where would I use it (examples), will it behave (sizes, motion, packages).
// Sections alternate plain and surface backgrounds (the gallery strip is always surface).
import { BaseLayout, CallToAction, GalleryStrip, InstallCommand, Section } from 'astro-project-site/components';
import '../styles/landing.css';
import { readFileSync } from 'node:fs';
import { resolve } from 'node:path';
import { gzipSync } from 'node:zlib';

const assets = '/apps/demo/assets';

// "Small": download sizes measured from the files at build time (gzip, level 9; the prebuild step makes demo/assets),
// so the numbers on the page are always the files it plays. KB = 1024 bytes.
const root = resolve(process.cwd(), '..');
const gzipKB = (file: string) => gzipSync(readFileSync(resolve(root, file)), { level: 9 }).length / 1024;
const kb = (n: number) => (n < 10 ? n.toFixed(1) : Math.round(n).toString());
const scriptKB = kb(gzipKB('packages/runtime/src/pixel-sprite.js'));
// Characters with different levels of detail, smallest file first. What makes a file bigger is mostly texture (fur
// and cloth compress far worse than flat colour), then the number of frames, then front and back views. `texture`
// names the textured materials of each example spec (packages/pixel-studio/examples/); frames and views are read
// from the bundle.
const weights = [
  { file: 'robot', name: 'Bolt the robot', texture: 'metal' },
  { file: 'moss', name: 'Moss', texture: 'flat colours' },
  { file: 'slime', name: 'Gloop the slime', texture: 'flat colours' },
  { file: 'pip', name: 'Pip', texture: 'hair, cloth, leather' },
  { file: 'fox', name: 'Ember the fox', texture: 'fur' },
  { file: 'goose-root', name: 'root the goose', texture: 'feathers, cloth, metal' },
]
  .map((s) => {
    const path = `demo/assets/${s.file}.bundle.json`;
    const anims: Record<string, { frames: number }> = JSON.parse(readFileSync(resolve(root, path), 'utf8')).animations;
    const frames = Object.values(anims).reduce((sum, a) => sum + a.frames, 0);
    const turns = Object.keys(anims).some((n) => n.includes('@'));
    return { ...s, size: gzipKB(path), detail: `${frames} frames · ${s.texture}${turns ? ' · turns around' : ''}` };
  })
  .sort((a, b) => a.size - b.size)
  .map((s) => ({ ...s, kb: kb(s.size) }));
const play = '/apps/studio/play.html';

// The hero's cast; `who` is read out when one is picked. `studio` opens that character in the studio's simple view
// (studio/app.js reads ?c=, like the playground): the one place these links are made. Every link to it on the page
// ("Customize …" under the demo, "Open the studio" further down and in the closing call to action) follows the pick.
const cast = [
  { id: 'goose-root', label: 'Goose', customize: 'Customize this goose', alt: 'root, a hacker goose in a hoodie', who: 'Meet root. A goose in a hoodie, never far from a laptop.' },
  { id: 'fox', label: 'Fox', customize: 'Customize Ember', alt: 'Ember the fox', who: 'Meet Ember. A fox with a curious streak.' },
  { id: 'pip', label: 'Pip', customize: 'Customize Pip', alt: 'Pip the adventurer', who: 'Meet Pip. Small, brave, always packing for a trip.' },
].map((c) => ({ ...c, studio: `/apps/studio/?c=${encodeURIComponent(c.id)}` }));

// "Make it yours": goose-root's looks, each an excerpt of packages/pixel-studio/examples/goose-root.json.
const looks = [
  {
    skin: '',
    label: 'Hoodie',
    code: `{
  "extends": "goose-base.json",
  "name": "root (hacker goose)",
  "materials": {
    "hoodie": { "color": "#4a5272", "texture": "cloth" },
    "shades": { "color": "#16161e", "shine": 0.6 },
    "lens":   { "color": "#46ff7a" }
  },
  "materialMap": { "plumage": "hoodie" }
}`,
  },
  {
    skin: 'party',
    label: 'Party hat',
    code: `"skins": {
  "party": {
    "materials": {
      "partyHat": { "color": "#ff5fa2", "texture": "stripes" },
      "pompom":   { "color": "#ffd84a" }
    },
    "parts": [{ "id": "hat", "parent": "head", "shapes": [
      { "type": "polygon", "points": [[59.5,17.5], [68.5,17.5], [64.5,4]],
        "material": "partyHat" },
      { "type": "circle", "cx": 64.5, "cy": 4, "r": 2.4, "material": "pompom" }
    ] }]
  }
}`,
  },
  {
    skin: 'redteam',
    label: 'Red team',
    code: `"skins": {
  "redteam": {
    "materials": {
      "hoodie": { "color": "#8e2b3a" },
      "lens":   { "color": "#ff4d5e" },
      "code":   { "color": "#ff4d5e" }
    }
  }
}`,
  },
];
const moves = [
  { anim: 'waddle', label: 'Waddle' },
  { anim: 'honk', label: 'Honk' },
  { anim: 'hack', label: 'Hack' },
  { anim: 'flap', label: 'Flap' },
  { anim: 'idle', label: 'Stand' },
];

const spriteEmbed = `<script type="module" src="pixel-sprite.js"></script>

<pixel-sprite src="goose-root.bundle.json"
  size="128" skin="party"
  alt="root, a goose in a party hat"></pixel-sprite>`;

const stageEmbed = `<script type="module" src="pixel-stage.js"></script>

<article class="card" data-pixel-surface>…</article>
<article class="card" data-pixel-surface>
  …
  <div class="crate" data-pixel-hide></div>
</article>

<pixel-stage>
  <pixel-actor src="goose-root.bundle.json" size="72"
    alt="root, a hacker goose"></pixel-actor>
</pixel-stage>`;

// "It notices you": triggered scenes (packages/pixel-studio/docs/stage.md#triggers), armed by the stage because
// their scripts are marked data-pixel-scene. reactSnippet shows the first one with shorter ids: keep them in step.
const sceneLetter = {
  name: 'the letter',
  cast: { gosling: '#ps-gosling' },
  trigger: { event: 'click', on: '#ps-send' },
  steps: [
    { actor: 'gosling', perform: 'flap', ms: 900 },
    { actor: 'gosling', pickUp: '.ps-letter', speed: 1.7 },
    { actor: 'gosling', exit: 'right', speed: 1.9 },
    { wait: 1600 },
    { emit: 'delivered' },
    { actor: 'gosling', enter: 'right' },
    { actor: 'gosling', say: 'posted!', ms: 1800 },
  ],
};
const sceneHello = {
  name: 'hello',
  cast: { gosling: '#ps-gosling' },
  trigger: { event: 'click', on: '.ps-hello' },
  steps: [
    { actor: 'gosling', face: '$trigger' },
    { actor: 'gosling', perform: 'honk' },
    { actor: 'gosling', say: 'hello!', ms: 1500 },
  ],
};
const reactSnippet = `<button id="send">Send a demo letter</button>
<span class="letter" hidden></span>

<script type="application/json" data-pixel-scene>
{
  "cast": { "gosling": "#gosling" },
  "trigger": { "event": "click", "on": "#send" },
  "steps": [
    { "actor": "gosling", "perform": "flap", "ms": 900 },
    { "actor": "gosling", "pickUp": ".letter", "speed": 1.7 },
    { "actor": "gosling", "exit": "right", "speed": 1.9 },
    { "wait": 1600 },
    { "emit": "delivered" },
    { "actor": "gosling", "enter": "right" },
    { "actor": "gosling", "say": "posted!" }
  ]
}
</script>`;
---

<BaseLayout>
  <section class="ps-hero" aria-labelledby="ps-hero-title">
    <div class="ps-hero-text">
      <p class="ps-eyebrow">Pixel characters for the web</p>
      <h1 id="ps-hero-title">Characters that live on your page.</h1>
      <p class="ps-lead">
        Create animated pixel characters. Give them a home on your website.
      </p>
      <div class="ps-actions">
        <a class="site-btn site-btn--primary ps-try" href="#try">Try a character <span aria-hidden="true">→</span></a>
        <a class="ps-link" href="#embed">See the embed <span aria-hidden="true">↘</span></a>
      </div>
      <p class="ps-status">Open source · MIT · Alpha</p>
    </div>

    <section class="ps-demo" id="try" aria-labelledby="ps-demo-title">
      <div class="ps-demo-head">
        <h2 id="ps-demo-title">Your layout is their playground.</h2>
        <fieldset class="ps-seg" data-group="cast">
          <legend class="site-visually-hidden">Character</legend>
          {cast.map((c, i) => (
            <label><input type="radio" name="cast" value={c.id} checked={i === 0} /><span>{c.label}</span></label>
          ))}
        </fieldset>
      </div>
      <div class="ps-window">
        <p class="ps-window-bar" aria-hidden="true"><span>your next project</span><i></i></p>
        <div class="ps-window-cards">
          <article class="ps-mini ps-mini--a" data-pixel-surface>
            <h3>A small idea.</h3>
            <p class="ps-lines" aria-hidden="true"><i></i><i></i></p>
          </article>
          <article class="ps-mini ps-mini--b" data-pixel-surface>
            <h3>A little life.</h3>
            <p class="ps-lines" aria-hidden="true"><i></i><i></i></p>
            <div class="ps-crate" data-pixel-hide aria-hidden="true"></div>
          </article>
        </div>
        <div class="ps-window-ground" data-pixel-surface aria-hidden="true"></div>
      </div>
      <div class="ps-moves" role="group" aria-label="Make it move">
        <button type="button" data-move="walk">Walk</button>
        <button type="button" data-move="jump">Jump</button>
        <button type="button" data-move="hide">Hide</button>
      </div>
      <div class="ps-demo-foot">
        <p class="ps-who" aria-live="polite">{cast[0].who}</p>
        <a class="ps-link ps-customize" href={cast[0].studio}><span class="ps-customize-label">{cast[0].customize}</span> <span aria-hidden="true">→</span></a>
      </div>
      <p class="ps-still" hidden>Your device asks for reduced motion, so the characters stand still.</p>
    </section>
  </section>

  <Section id="make" tone="surface" title="Make it yours" intro="A character is a short description you can change: colours, materials, extra parts, alternative looks. Pick a look, then a move. It is the same goose throughout.">
    <div class="ps-make">
      <div class="ps-make-preview">
        <pixel-sprite class="ps-make-sprite" src={`${assets}/goose-root.bundle.json`} anim="waddle" size="192" states="off" alt="root, a hacker goose in a hoodie, waddling"></pixel-sprite>
        <fieldset class="ps-seg" data-group="skin">
          <legend class="site-visually-hidden">Look</legend>
          {looks.map((l, i) => (
            <label><input type="radio" name="skin" value={l.skin} checked={i === 0} /><span>{l.label}</span></label>
          ))}
        </fieldset>
        <fieldset class="ps-seg ps-seg--small" data-group="anim">
          <legend class="site-visually-hidden">Move</legend>
          {moves.map((m, i) => (
            <label><input type="radio" name="anim" value={m.anim} checked={i === 0} /><span>{m.label}</span></label>
          ))}
        </fieldset>
      </div>
      <figure class="ps-code">
        <figcaption>From <a href="/apps/packages/pixel-studio/examples/goose-root.json"><code>examples/goose-root.json</code></a></figcaption>
        {looks.map((l, i) => (
          <pre data-look={l.skin} hidden={i !== 0}><code>{l.code}</code></pre>
        ))}
        <a class="ps-link ps-open" href={`${play}?c=goose-root&anim=waddle`}>Keep editing this goose in the playground <span aria-hidden="true">→</span></a>
      </figure>
    </div>
  </Section>

  <Section id="embed" title="Put it on a page" intro="Two files from @pixel-studio/runtime, no build step and no dependencies. A sprite plays where you put it; a stage lets characters move around your layout.">
    <div class="ps-embeds">
      <article class="ps-embed">
        <div class="ps-embed-result">
          <pixel-sprite src={`${assets}/goose-root.bundle.json`} anim="idle" size="128" skin="party" alt="root, a goose in a party hat: hover or tap it"></pixel-sprite>
        </div>
        <div class="ps-embed-text">
          <h3>A sprite</h3>
          <p>One element, one bundle file. Its behaviour comes with the bundle: hover and it gets back to hacking, tap and it honks (tap fast and it panics).</p>
          <pre><code>{spriteEmbed}</code></pre>
          <a class="ps-link" href="/docs/reference/runtime/">The sprite element <span aria-hidden="true">→</span></a>
        </div>
      </article>
      <article class="ps-embed">
        <div class="ps-embed-result ps-embed-result--stage">
          <p>Mark elements as surfaces and hiding spots. The demo at the top of this page is a stage like this one.</p>
          <a class="site-btn" href="#try">Back to the demo <span aria-hidden="true">↑</span></a>
        </div>
        <div class="ps-embed-text">
          <h3>A stage</h3>
          <p>Characters walk along the top edges of your elements, jump between them and hide. They never block a click.</p>
          <pre><code>{stageEmbed}</code></pre>
          <a class="ps-link" href="/docs/reference/stage/">How the stage works <span aria-hidden="true">→</span></a>
        </div>
      </article>
    </div>
    <div class="ps-install">
      <InstallCommand command="npm i @pixel-studio/runtime" />
      <a class="ps-link" href="/docs/reference/getting-started/">Getting started, step by step <span aria-hidden="true">→</span></a>
    </div>
  </Section>

  <Section id="react" tone="surface" title="It notices you" intro="Characters respond to the reader and to the page: a tap, a click on a button, a hurried scroll. The response is a scene written as data, with no animation code.">
    <div class="ps-react">
      <div class="ps-react-page">
        <article class="ps-react-card" data-pixel-surface>
          <h3>The newsletter</h3>
          <p>One letter a month, delivered by hand. Or by wing.</p>
          {/* One button, no address field: it is plainly a demo, and nothing leaves the page. */}
          <div class="ps-react-send">
            <button type="button" class="site-btn site-btn--primary" id="ps-send">Send a demo letter</button>
            <span class="ps-letter" hidden aria-hidden="true"></span>
          </div>
          <p class="ps-react-status" aria-live="polite"></p>
        </article>
        <button type="button" class="site-btn ps-hello">Say hello</button>
      </div>
      <ul class="ps-react-list">
        <li><strong>Tap it.</strong> It startles and runs off.</li>
        <li><strong>Tap it fast.</strong> It panics, a little faster with every tap.</li>
        <li><strong>Pick it up</strong> and throw it: drag it with a mouse, or press and hold it on a phone.</li>
        <li><strong>Scroll fast.</strong> It calls after you.</li>
        <li><strong>Say hello.</strong> A click on any element can start a scene.</li>
        <li><strong>Send a letter.</strong> It posts it, and comes back.</li>
      </ul>
    </div>
    <div class="ps-react-ground" data-pixel-surface aria-hidden="true"></div>
    <details class="ps-reveal">
      <summary><svg class="ps-reveal-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M6 3.5 10.5 8 6 12.5" /></svg>Show scene code</summary>
      <figure class="ps-code ps-react-code">
        <figcaption>The letter, as a scene in the page (a <code>trigger</code> arms it):</figcaption>
        <pre><code>{reactSnippet}</code></pre>
      </figure>
    </details>
    <p class="ps-more"><a class="ps-link" href="/docs/reference/stage/#triggers">Scenes and triggers <span aria-hidden="true">→</span></a></p>
  </Section>

  {/* The gosling here and in the details plays a side-view-only bundle, half the size (scripts/build-demo.mjs). The
      hero's cast shares its default bundles with the "Small" row, so the page downloads each of them once. */}
  <pixel-stage label="characters" controls="none" floor="none">
    <pixel-actor class="ps-hero-actor" src={`${assets}/${cast[0].id}.bundle.json`} size="72" alt={cast[0].alt} start=".ps-mini--a" directed></pixel-actor>
    <pixel-actor id="ps-gosling" src={`${assets}/goose-kiddie.lean.bundle.json`} size="64" alt="a gosling in a red cap" start=".ps-react-card" directed></pixel-actor>
  </pixel-stage>
  <script is:inline type="application/json" data-pixel-scene set:html={JSON.stringify(sceneLetter)} />
  <script is:inline type="application/json" data-pixel-scene set:html={JSON.stringify(sceneHello)} />

  <Section id="studio" title="Make your own, in the studio or with an agent" intro="Describe a character in a sentence. Claude writes its spec, the engine draws it at every size, and Claude looks at the drawing and refines it. Or start from an example and edit it yourself.">
    <div class="ps-split ps-split--studio">
      <ol class="ps-loop">
        <li><span>1</span><div><strong>Ask</strong> for “a small grey robot with an antenna that waves hello”.</div></li>
        <li><span>2</span><div><strong>See it</strong> drawn at 16, 32 and 64 px, in every animation.</div></li>
        <li><span>3</span><div><strong>Refine it</strong>: “make the antenna blink”. Claude edits the spec and checks the new drawing.</div></li>
        <li><span>4</span><div><strong>Export</strong> one bundle file for your page.</div></li>
      </ol>
      <figure class="ps-shot">
        <img src="/landing/studio.webp" width="1280" height="800" alt="The studio: the JSON spec on the left; the goose large in the middle, its animations above and the same goose at 16 to 64 px below; rendering settings on the right" loading="lazy" decoding="async" />
      </figure>
    </div>
    <div class="ps-key">
      <div class="ps-actions">
        <a class="site-btn site-btn--primary" href={cast[0].studio}>Open the studio</a>
        <a class="site-btn" href={play}>Try the playground</a>
      </div>
      <p>Creating with Claude needs your Anthropic API key. It stays in your browser, and requests go straight to the API. Without a key, the examples, the editor and the playground all work.</p>
    </div>
  </Section>

  <GalleryStrip title="See it in context" intro="A demo site, a stage, a small game and the studio's tools, all built with the same two packages." limit={3} />

  <Section id="details" tone="surface" title="Built to behave" intro="The details that make a character feel at home on a page, and keep it out of the way.">
    <div class="ps-weight">
      <div class="ps-detail-text">
        <h3>Small, and only as big as you make it</h3>
        <p>A whole animated character can be {weights[0].kb} KB. The file grows with the detail it carries: textures like fur and cloth most of all, then more frames, then front and back views for characters that turn around. Every size here is the file that character is playing, compressed as a web server sends it.</p>
        <p class="ps-weight-script">Plus the script, once for every character on the page: <strong>{scriptKB} KB</strong>. An off-screen sprite stops drawing.</p>
        <a class="ps-link" href="/docs/reference/performance/">Performance in detail <span aria-hidden="true">→</span></a>
      </div>
      <ol class="ps-ladder" aria-label="Example characters, from the smallest file to the largest">
        {weights.map((s) => (
          <li>
            <pixel-sprite src={`${assets}/${s.file}.bundle.json`} anim="idle" size="72" states="off" alt={s.name} />
            <strong>{s.kb} KB</strong>
            <span>{s.detail}</span>
          </li>
        ))}
      </ol>
    </div>

    <div class="ps-detail">
      <div class="ps-detail-text">
        <h3>Sharp at every size</h3>
        <p>A bundle holds the character at 16, 32 and 64 px. The runtime picks the sharpest one for the size and the screen and scales it in whole device pixels, so it never blurs.</p>
      </div>
      <div class="ps-sizes" role="group" aria-label="The same fox at four sizes">
        {[32, 64, 128, 192].map((size) => (
          <figure>
            <pixel-sprite src={`${assets}/fox.bundle.json`} anim="idle" size={size} hover-anim="trot" alt={`Ember the fox at ${size} px`} />
            <figcaption>{size} px</figcaption>
          </figure>
        ))}
      </div>
    </div>

    <div class="ps-detail">
      <div class="ps-detail-text">
        <h3>Motion with planted feet</h3>
        <p>Each character stands on a skeleton with motion models for walking, running, jumping and climbing. Feet stay planted, heads stay steady, tails follow through. The fox's gallop is measured from Muybridge's photographs of running hounds.</p>
        <a class="ps-link" href="/apps/studio/figures.html">Explore the figures <span aria-hidden="true">→</span></a>
      </div>
      <div class="ps-gaits">
        <figure><pixel-sprite src={`${assets}/fox.bundle.json`} anim="gallop" size="112" alt="the fox galloping" /><figcaption>gallop</figcaption></figure>
        <figure><pixel-sprite src={`${assets}/goose-kiddie.lean.bundle.json`} anim="waddle" size="112" alt="a gosling waddling" /><figcaption>waddle</figcaption></figure>
        <figure><pixel-sprite src={`${assets}/pip.bundle.json`} anim="run" size="112" alt="Pip running" /><figcaption>run</figcaption></figure>
        <figure><pixel-sprite src={`${assets}/moss.bundle.json`} anim="climb" size="112" alt="Moss climbing" /><figcaption>climb</figcaption></figure>
      </div>
    </div>

    <ul class="ps-facts">
      <li><strong>Polite.</strong> Pauses off-screen, respects reduced motion, has a pause button, and reads its <code>alt</code> to screen readers.</li>
      <li><strong>Interactive.</strong> Hover and click animations, events for footsteps and landings, attachment points, state machines and skins.</li>
      <li><strong>Portable.</strong> No dependencies and no build step. For a game engine, <code>pixel export</code> writes sheets Phaser and PixiJS load.</li>
      <li><strong>Checked.</strong> A JSON schema, a spec reference, and errors with a JSON path and a did-you-mean.</li>
    </ul>

    <div class="ps-packages">
      <article class="ps-package">
        <p class="ps-tag">@pixel-studio/runtime</p>
        <h3>Play them</h3>
        <p><code>&lt;pixel-sprite&gt;</code> and <code>&lt;pixel-stage&gt;</code>: everything a website needs.</p>
        <InstallCommand command="npm i @pixel-studio/runtime" />
      </article>
      <article class="ps-package">
        <p class="ps-tag">@pixel-studio/core</p>
        <h3>Make them</h3>
        <p>The engine, the <code>pixel</code> command, the figures and the example characters.</p>
        <InstallCommand command="npm i @pixel-studio/core" />
      </article>
    </div>
    <p class="ps-note">Both packages are released together, under one version.</p>
  </Section>

  <CallToAction
    title="Give your project a character"
    body="Free and open source under the MIT licence. Every example on this site is live."
    primary={{ label: 'Open the studio', href: cast[0].studio }}
    secondary={{ label: 'Get started', href: '/docs/reference/getting-started/' }}
  />

  {/* One control for every character. Its name stays "Pause characters" and aria-pressed says whether they are paused
      (a name that flipped to "Play" as well would read as "Play characters, pressed"). On phones only the icon shows. */}
  <button type="button" class="ps-pause" aria-pressed="false">
    <svg class="ps-pause-icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path class="ps-pause-bars" d="M4 3h3v10H4zM9 3h3v10H9z" />
      <path class="ps-pause-play" d="M4.5 2.5v11l9-5.5z" />
    </svg>
    <span class="ps-pause-label">Pause characters</span>
  </button>

  <script is:inline type="module" src="/apps/packages/runtime/src/pixel-stage.js"></script>
  <script is:inline define:vars={{ cast, play, sceneLetterName: sceneLetter.name }}>
    // A classic script (define:vars): everything it touches is in the HTML above it, and it only calls the
    // characters' methods once they exist.
    const $ = (s, root = document) => root.querySelector(s);
    const $$ = (s, root = document) => [...root.querySelectorAll(s)];
    const stage = $('pixel-stage');
    const pauseButton = $('.ps-pause');

    /** A segmented control (a fieldset of radios): call onPick with the value picked. */
    const segmented = (group, onPick) => $(`[data-group="${group}"]`).addEventListener('change', (e) => onPick(e.target.value));

    // ---- pause: one control for every character (WCAG 2.2.2); the stage's own button is off ----
    const setPaused = (paused) => {
      pauseButton.setAttribute('aria-pressed', String(paused));
      for (const sprite of $$('pixel-sprite')) sprite.toggleAttribute('paused', paused);
      if (stage?.pause) (paused ? stage.pause() : stage.resume());
    };
    pauseButton.addEventListener('click', () => setPaused(pauseButton.getAttribute('aria-pressed') !== 'true'));

    // ---- the hero: pick a character, then walk, jump or hide ----
    const cardA = $('.ps-mini--a'), cardB = $('.ps-mini--b'), crate = $('.ps-crate');
    const who = $('.ps-who');
    const actor = () => $('.ps-hero-actor', stage);
    const reduced = matchMedia('(prefers-reduced-motion: reduce)');
    const showStill = () => { $('.ps-still').hidden = !reduced.matches; };
    showStill();
    reduced.addEventListener?.('change', showStill);

    // A button press asks for motion: if the characters are paused, play them.
    const order = (fn) => {
      const a = actor();
      if (!a?.run) return;
      if (stage.paused) setPaused(false);
      fn(a);
    };
    // Walk shows the gait at its own speed. Jump and hide are errands: it hurries (runs, feet still planted) and
    // calms down when it gets there, unless a newer order has started meanwhile.
    let errand = 0;
    const hurried = async (a, action, ...args) => {
      const mine = ++errand;
      a.hurry(1.6);
      await a.run(action, ...args);
      if (mine === errand) a.hurry(1);
    };
    // The end of platform p nearest to (or farthest from) the character, a little way in.
    const end = (a, p, nearest) => {
      const left = Math.abs(a.x - p.x1) < Math.abs(a.x - p.x2) === nearest;
      return left ? p.x1 + a.W * 0.6 : p.x2 - a.W * 0.6;
    };
    const moves = {
      walk: (a) => {
        const p = a.platform;
        if (!p) return;
        errand++;
        a.hurry(1);
        a.run('goTo', { x: end(a, p, false), y: p.y - 1 });
      },
      // Over to the near end of the other card (from the ground: up to the first).
      jump: (a) => {
        const p = stage.world.platformOf(a.platform?.el === cardA ? cardB : cardA);
        if (p) hurried(a, 'goTo', { x: end(a, p, true), y: p.y - 1 });
      },
      hide: (a) => hurried(a, 'hideBehind', crate),
    };
    for (const b of $$('[data-move]')) b.addEventListener('click', () => order(moves[b.dataset.move]));

    let picked = cast[0];
    segmented('cast', (id) => {
      const c = cast.find((x) => x.id === id);
      if (!c || c === picked) return;
      const old = actor();
      const startOn = old?.platform?.el === cardB ? '.ps-mini--b' : '.ps-mini--a';
      const next = document.createElement('pixel-actor');
      const attrs = { class: 'ps-hero-actor', src: `/apps/demo/assets/${c.id}.bundle.json`, size: '72', alt: c.alt, start: startOn, directed: '' };
      for (const [k, v] of Object.entries(attrs)) next.setAttribute(k, v);
      old?.remove();
      stage.append(next);
      who.textContent = c.who;
      // Every link to the studio follows the pick: "Customize …" under the demo, "Open the studio" further down.
      for (const a of $$('a[href]')) if (a.getAttribute('href') === picked.studio) a.setAttribute('href', c.studio);
      $('.ps-customize-label').textContent = c.customize;
      picked = c;
    });

    // "Try a character": go to the demo and put the keyboard on its first control.
    $('.ps-try').addEventListener('click', (e) => {
      e.preventDefault();
      const demo = $('#try');
      demo.scrollIntoView({ behavior: reduced.matches ? 'auto' : 'smooth', block: 'center' });
      $('input:checked', demo).focus({ preventScroll: true });
      history.replaceState(null, '', '#try');
    });

    // ---- make it yours: one goose, three looks, five moves ----
    const sprite = $('.ps-make-sprite');
    const open = $('.ps-open');
    const look = { skin: '', anim: 'waddle' };
    const describe = () => {
      const dress = { '': 'in a hoodie', party: 'in a party hat', redteam: 'in a red hoodie' }[look.skin];
      const doing = { waddle: 'waddling', honk: 'honking', hack: 'hacking on a laptop', flap: 'flapping', idle: 'standing' }[look.anim];
      sprite.setAttribute('alt', `root, a hacker goose ${dress}, ${doing}`);
      const q = new URLSearchParams({ c: 'goose-root', anim: look.anim });
      if (look.skin) q.set('skin', look.skin);
      open.href = `${play}?${q}`;
    };
    segmented('skin', (skin) => {
      look.skin = skin;
      if (look.skin) sprite.setAttribute('skin', look.skin); else sprite.removeAttribute('skin');
      for (const pre of $$('#make pre[data-look]')) pre.hidden = pre.dataset.look !== look.skin;
      describe();
    });
    segmented('anim', (anim) => {
      look.anim = anim;
      sprite.setAttribute('anim', look.anim);
      describe();
    });
    // A one-shot (the honk) would stop on its last frame: while it is the chosen move, play it again after a beat.
    // (This sprite has states="off": goose-root's own state machine would otherwise ignore the move picked.)
    sprite.addEventListener('pixel-end', (e) => {
      const anim = e.detail?.anim;
      if (anim !== look.anim) return;
      setTimeout(() => {
        if (look.anim === anim && !sprite.hasAttribute('paused')) sprite.play(anim, { restart: true });
      }, 900);
    });

    // ---- it notices you: the scenes are armed by the stage; the page shows the letter and says what happened ----
    // The scene's trigger and this listener both hear the click; the stage plays the scene a moment later, once the
    // letter is showing. Like the stage, the page ignores the button until that scene has ended.
    const letter = $('.ps-letter'), status = $('.ps-react-status');
    let posting = false, delivered = false;
    const clearLetter = () => { letter.hidden = true; letter.style.visibility = ''; };
    $('#ps-send').addEventListener('click', () => {
      if (posting) return;
      posting = true;
      delivered = false;
      letter.hidden = false;
      status.textContent = 'The gosling is on it.';
    });
    stage.addEventListener('pixel-sceneevent', (e) => {
      if (e.detail?.name !== 'delivered') return;
      delivered = true;
      clearLetter();
      status.textContent = 'Posted.';
    });
    // Cut short (by another scene, say): put things back so the button works again.
    stage.addEventListener('pixel-sceneend', (e) => {
      if (e.detail?.scene !== sceneLetterName) return;
      posting = false;
      if (!delivered) { clearLetter(); status.textContent = ''; }
    });
    // A fast scroll: once it settles, whoever is on screen calls after the reader (at most every few seconds).
    let hurriedScroll = false, called = -Infinity;
    stage.addEventListener('pixel-fastscroll', () => { hurriedScroll = true; });
    stage.addEventListener('pixel-scrollsettle', () => {
      if (!hurriedScroll) return;
      hurriedScroll = false;
      if (performance.now() - called < 4000) return;
      called = performance.now();
      for (const a of $$('pixel-actor', stage)) {
        const r = a.getBoundingClientRect();
        if (r.bottom > 0 && r.top < innerHeight && a.say) a.say('wait for me!', 1600);
      }
    });

    customElements.whenDefined('pixel-stage').then(() => { if (stage?.paused) setPaused(true); });
  </script>
</BaseLayout>
