{
  "name": "pixel-studio-site",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build && project-site docs:check",
    "preview": "astro preview",
    "check": "astro check",
    "docs:gen": "project-site docs:gen",
    "docs:check": "project-site docs:check",
    "deploy": "npm run build && wrangler deploy",
    "deploy:preview": "npm run build && project-site deploy:preview",
    "cf:dev": "node ../scripts/build-demo.mjs && astro build && wrangler dev --port 8787",
    "prebuild": "node ../scripts/build-demo.mjs"
  },
  "dependencies": {
    "@astrojs/rss": "^4.0.19",
    "@astrojs/starlight": "^0.43.1",
    "astro": "^7.3.8",
    "astro-project-site": "^0.1.0-beta.7",
    "mermaid": "^12.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "typescript": "^6.0.3",
    "wrangler": "^4.165.0"
  }
}
