  "legA": "stance in frames 1-2, toe-off between 2 and 3",
  "legB": "lands between frames 6 and 7, stance 7-10. Near/far could not be told apart with confidence on this plate (similar lighting on both legs)",
  "arms": "'Fwd'/'Back' = whichever arm is ahead of / behind the shoulder in that frame"
 },
 "angleDefinitions": {
  "thigh": "knee relative to hip, degrees from vertical, + = knee ahead of the hip (runner faces +x)",
  "hipFlex": "thigh + trunkLean: thigh relative to the trunk line, + = flexion",
  "kneeFlex": "180 - angle(hip, knee, ankle); 0 = straight",
  "ankle": "unsigned angle knee-ankle-toe tip (larger = more plantarflexed; our figure's standing rest is 116)",
  "trunkLean": "hip -> shoulder line from vertical, + = forward",
  "upperArm": "shoulder -> elbow from vertical, + = forward",
  "elbowFlex": "180 - angle(shoulder, elbow, wrist); 0 = straight"
 },
